OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
DATABASE_URL=postgresql://rf:rf_dev_password@localhost:5432/rfengineer

# Self-hosted, OpenAI-compatible embedding/LLM backend (ADR-0004). Mandatory
# for SENSITIVE/RESTRICTED documents; no fallback to OPENAI_API_KEY for those.
LOCAL_LLM_BASE_URL=
LOCAL_LLM_API_KEY=
LOCAL_EMBEDDING_MODEL=
# PUBLIC/INTERNAL documents use this backend absent an explicit choice.
# "local" or "external".
DEFAULT_LLM_BACKEND=local
# document_chunks.embedding / .embedding_local vector-column dimensions
# (db/apply_schema.py reads these when applying db/schema.sql).
EMBEDDING_DIM_EXTERNAL=1536
EMBEDDING_DIM_LOCAL=1536

NEC2PP_BIN=
OPENEMS_BIN=
# HFSS execution is confined to a controlled, licensed workstation (issue
# #40) -- HFSS_ENABLED=true alone is NOT sufficient. HFSS_WORKSTATION_ID
# (this host's own declared identity) must also be set and must equal
# HFSS_ALLOWED_WORKSTATION_ID (the operator's configured allow-listed
# value), pyaedt must actually be importable, and an ANSYSEM_ROOT*
# environment variable (set by AEDT's own installer) must be present --
# see simulation/hfss.py's check_hfss_workstation_confinement().
HFSS_ENABLED=false
HFSS_WORKSTATION_ID=
HFSS_ALLOWED_WORKSTATION_ID=
HFSS_ARCHIVE_DIR=
AEDT_VERSION=
ADS_ENABLED=false

ALLOW_INSTRUMENT_CONTROL=false
ALLOW_PRODUCTION_RELEASE=false
ALLOW_EXTERNAL_NETWORK_TOOLS=false
