OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
DATABASE_URL=postgresql://rf:rf_dev_password@localhost:5432/rfengineer

# Who answers the agent's OWN reasoning/tool-calling calls (agent/main.py).
# "openai" (paid, OpenAI's API, needs OPENAI_API_KEY above), "anthropic"
# (paid, Claude via the openai-agents SDK's LiteLLM extension, needs
# ANTHROPIC_API_KEY below), "local" (free, a self-hosted OpenAI-
# compatible server -- Ollama by default, see docker-compose.yml's
# `ollama` service -- no per-token cost), or "runpod" (paid-per-second,
# a RunPod Serverless vLLM endpoint you deploy yourself -- see RUNPOD_*
# below; useful for a model too large for local GPU VRAM). Deliberately
# separate from DEFAULT_LLM_BACKEND below, which is about the knowledge
# base's data sensitivity, not the agent's own provider choice -- "runpod"
# is a hosted cloud API from a data-egress standpoint, same category as
# "openai"/"anthropic", not "local".
LLM_PROVIDER=local
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Model tag to request from the local server (e.g. `ollama pull gpt-oss:20b`
# then set this to gpt-oss:20b) when LLM_PROVIDER=local.
LOCAL_AGENT_MODEL=gpt-oss:20b

# RunPod Serverless vLLM endpoint (LLM_PROVIDER=runpod) -- deploy a vLLM
# quick-deploy or custom worker on runpod.io first, then fill these in from
# that endpoint's dashboard page. No sensible defaults exist for either --
# agent/main.py raises a clear error at startup if LLM_PROVIDER=runpod and
# either is missing, rather than a confusing 401/404 on first agent call.
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
# The exact model name your endpoint was deployed with (vLLM validates this
# against what it's actually serving) -- no default, unlike LOCAL_AGENT_MODEL.
RUNPOD_MODEL=

# Self-hosted, OpenAI-compatible embedding/LLM backend (ADR-0004) for the
# KNOWLEDGE BASE's embedding/extraction calls (knowledge/embedding.py,
# knowledge/extraction_llm.py) -- mandatory for SENSITIVE/RESTRICTED
# documents; no fallback to OPENAI_API_KEY for those. Defaults point at the
# same docker-compose.yml `ollama` service LLM_PROVIDER=local above uses --
# one running server answers both roles.
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# Ollama ignores this value (no real auth); any non-empty placeholder works.
LOCAL_LLM_API_KEY=ollama
# BAAI/bge-m3 (`ollama pull bge-m3`) -- see EMBEDDING_DIM_LOCAL below for
# why this specific model's dimension matters.
LOCAL_EMBEDDING_MODEL=bge-m3
# Model tag knowledge/extraction_llm.py's _extract_via_local requests from
# the local server -- distinct from LOCAL_AGENT_MODEL above (extraction is
# structured-output work, not open-ended reasoning; they may reasonably be
# the same tag or different ones depending on what's loaded).
LOCAL_EXTRACTION_MODEL=gpt-oss:20b
# PUBLIC/INTERNAL documents use this backend absent an explicit choice.
# "local" or "external".
DEFAULT_LLM_BACKEND=local
# document_chunks.embedding / .embedding_local vector-column dimensions
# (db/apply_schema.py reads these when applying db/schema.sql).
# EMBEDDING_DIM_LOCAL=1024 matches BAAI/bge-m3's actual, fixed dense-
# embedding dimension (confirmed from its own Hugging Face model card) --
# it must change if LOCAL_EMBEDDING_MODEL is ever swapped for a model with
# a different native dimension (e.g. nomic-embed-text tops out at 768).
EMBEDDING_DIM_EXTERNAL=1536
EMBEDDING_DIM_LOCAL=1024

# Component/manufacturer-intelligence data sources (all free developer
# tiers, no purchase -- see docs/FREE_AND_OPEN_SOURCE_TOOLING.md). Sign up
# yourself at each provider; these feed knowledge/ingest.py's
# source_type='datasheet' pipeline via knowledge/digikey.py, mouser.py,
# nexar.py (ticket #67) -- credentials here alone are NOT sufficient,
# ALLOW_EXTERNAL_NETWORK_TOOLS=true (below) must also be set.
# Digi-Key Product Information API v4 -- OAuth2 client_credentials:
# https://developer.digikey.com/
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
# Mouser Search API -- single API key: https://www.mouser.com/api-hub/
MOUSER_API_KEY=
# Nexar API (Octopart data) -- OAuth2 client_credentials:
# https://nexar.com/api
NEXAR_CLIENT_ID=
NEXAR_CLIENT_SECRET=
# 3GPP/ETSI/FCC eCFR/arXiv need no API key or account -- see
# docs/FREE_AND_OPEN_SOURCE_TOOLING.md's "Component/manufacturer
# intelligence & external standards data" section.

# USPTO Open Data Portal (ODP) full-text patent search (issue #280) --
# knowledge/sourcing/patent.py's search_uspto_patents. Unlike the other
# knowledge/sourcing/ clients above, this one is credentialed: a free
# USPTO.gov account (https://data.uspto.gov/) whose identity has been
# additionally verified with ID.me, which then lets you request an API key
# from the ODP "Getting Started"/"Manage API Key" page. Sent as the
# X-Api-Key header -- confirmed live this ticket (a request with no key
# gets HTTP 401 before the query is even read; a wrong key gets HTTP 403).
# ingest_patent's own fetch-by-number USPTO PDF endpoint needs none of this
# -- only search does. ALLOW_EXTERNAL_NETWORK_TOOLS=true (below) must also
# be set.
USPTO_ODP_API_KEY=

NEC2PP_BIN=
OPENEMS_BIN=
# ngspice: on Linux the plain default "ngspice" already works with zero
# config (Ubuntu's own apt package, and this repo's Dockerfile, both name
# the binary exactly that). On Windows, no installer exists -- run
# `pwsh scripts/install_ngspice_windows.ps1` (downloads/checksums/extracts
# a portable build, no Administrator rights needed) and set this to the
# printed path (the Windows console binary is ngspice_con.exe, not
# ngspice.exe -- see that script's own output).
NGSPICE_BIN=
XYCE_BIN=
QUCSATOR_BIN=
PALACE_BIN=
OPENPAREM3D_BIN=
GERBER2EMS_BIN=
LTSPICE_BIN=
ELMERSOLVER_BIN=
GMSH_BIN=
ELMERGRID_BIN=
# geometry/freecad_curved.py's default. On Linux via the FreeCAD-maintainers
# PPA the installed binary is lowercase `freecadcmd` -- this repo's
# Dockerfile symlinks it to the mixed-case name below so no override is
# needed there; set this explicitly if installing FreeCAD another way.
FREECAD_BIN=
# HFSS execution is confined to a controlled, licensed workstation (issue
# #40) -- HFSS_ENABLED=true alone is NOT sufficient. HFSS_WORKSTATION_ID
# (this host's own declared identity) must also be set and must equal
# HFSS_ALLOWED_WORKSTATION_ID (the operator's configured allow-listed
# value), pyaedt must actually be importable, and an ANSYSEM_ROOT*
# environment variable (set by AEDT's own installer) must be present --
# see simulation/hfss.py's check_hfss_workstation_confinement().
HFSS_ENABLED=false
HFSS_WORKSTATION_ID=
HFSS_ALLOWED_WORKSTATION_ID=
HFSS_ARCHIVE_DIR=
AEDT_VERSION=
ADS_ENABLED=false

ALLOW_PRODUCTION_RELEASE=false
# Gates knowledge/digikey.py, knowledge/mouser.py, knowledge/nexar.py
# (ticket #67, lookup_digikey_component/lookup_mouser_component/
# lookup_nexar_component in agent/main.py and mcp_server/server.py), and
# (issue #280) knowledge/sourcing/patent.py's search_uspto_patents --
# ALLOW_EXTERNAL_NETWORK_TOOLS=true alone is NOT sufficient for a given
# lookup to actually succeed; that provider's own credentials below (e.g.
# DIGIKEY_CLIENT_ID/DIGIKEY_CLIENT_SECRET, or USPTO_ODP_API_KEY) must also
# be configured.
ALLOW_EXTERNAL_NETWORK_TOOLS=false
